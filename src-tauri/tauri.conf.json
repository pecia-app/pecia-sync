{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pecia Sync",
  "version": "0.2.0",
  "identifier": "app.pecia.sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run licenses:generate && npm run licenses:check && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pecia Sync",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "useLocalToolsDir": true,
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSES/GPL-3.0-or-later.txt",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../LICENSES/": "licenses/texts/",
      "../docs/LICENSING.md": "licenses/LICENSING.md",
      "../build/licenses/": "licenses/dependencies/"
    },
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
